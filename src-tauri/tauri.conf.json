{
  "productName": "Aba Avner",
  "version": "0.1.1",
  "identifier": "com.tomer.aba-avner",
  "build": {
    "beforeBuildCommand": { "script": "bash prepare-ui.sh", "cwd": "scripts" },
    "beforeDevCommand": { "script": "bash prepare-ui.sh", "cwd": "scripts" },
    "devUrl": null,
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "windows": [
      {
        "title": "Aba Avner",
        "width": 720,
        "height": 560,
        "resizable": false
      }
    ]
  },
  "bundle": {
    "publisher": "Tomer",
    "copyright": "Copyright © 2026 Tomer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFOUNDMDMyMkIzMDkyQTAKUldTZ2tqQXJNc0NjdmpsTTRWZVN4M3dFMkhBUnlubWoxZ2F5VDNkQWhNWlZ5VlFxNkdWaVA5WVcK",
      "endpoints": [
        "https://github.com/tomerdev1/aba-avner-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
